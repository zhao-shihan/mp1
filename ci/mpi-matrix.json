{
  "schema": 3,
  "mpi_minimum": "4.1",
  "notes": [
    "Every provider must advertise MPI 4.1 or newer; MPICH 4.3.2 advertises MPI 4.1.",
    "A tarball provider is pinned by URL and SHA256; install-mpi.sh verifies the checksum before extraction.",
    "A oneapi-apt provider is installed from Intel's official oneAPI apt repository and tracks the latest package in that channel. It is not in the Ubuntu archive; the apt repository is the supported channel.",
    "The oneapi-apt packages are intentionally not pinned to an exact build; ci/assert-mpi.sh fails closed if the installed provider version no longer matches the matrix version.",
    "Open MPI 6.0.0rc3 is the current Open MPI release candidate.",
    "require_features is an opt-in, job-specific feature gate: list 'shared' only for a provider that exposes a multi-process shared-memory domain. A provider without that capability stays in the matrix without 'shared', and the shared-memory scenario may skip there."
  ],
  "providers": [
    {
      "id": "mpich-4.3.2",
      "family": "mpich",
      "version": "4.3.2",
      "advertised_mpi_version": "4.1",
      "install": "tarball",
      "url": "https://www.mpich.org/static/downloads/4.3.2/mpich-4.3.2.tar.gz",
      "sha256": "47d774587a7156a53752218c811c852e70ac44db9c502dc3f399b4cb817e3818"
    },
    {
      "id": "openmpi-6.0.0rc3",
      "family": "openmpi",
      "version": "6.0.0rc3",
      "advertised_mpi_version": "5.0",
      "install": "tarball",
      "url": "https://download.open-mpi.org/release/open-mpi/v6.0/openmpi-6.0.0rc3.tar.bz2",
      "sha256": "62d5420325d56e79718c7015d2d6653da735c98430ed2cd6f61771ba43067525"
    },
    {
      "id": "intel-2021.19",
      "family": "intel",
      "version": "2021.19",
      "advertised_mpi_version": "4.1",
      "install": "oneapi-apt",
      "apt_packages": [
        "intel-oneapi-mpi-devel",
        "intel-oneapi-libfabric"
      ],
      "runs_on": "ubuntu-24.04"
    }
  ],
  "profiles": {
    "pr": [
      {
        "provider": "mpich-4.3.2",
        "name": "mpich-4.3.2-debug",
